# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
DB_NAME=delivery_management
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARACTERS_MIN
JWT_EXPIRY=24h

# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# Logging Configuration
LOG_LEVEL=info

# CSRF Configuration
CSRF_PROTECTION=false # By default false for testing
